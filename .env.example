# Rawon V2 — Environment Configuration Example
# Copy to .env and configure your credentials before starting Docker Compose or local dev.

# --- Core Bot Configuration ---
NODE_ENV=production
DEBUG_MODE=false

# Single token OR comma-separated list of tokens for native Multi-Bot mode:
DISCORD_TOKEN=your_discord_bot_token_here

# Command prefix & optional primary server restriction
MAIN_PREFIX=!
DEV_PREFIX=r!
MAIN_SERVER=

# Comma-separated Discord User IDs with developer permissions (/eval, /login, /setup, /db-export, /db-import)
DEVS=

# Default bot locale (en-US, es-ES, fr-FR, id-ID, ja-JP, ko-KR, ms-MY, pt-BR, ru-RU, tr-TR, uk-UA, vi-VN, zh-CN, zh-TW)
LOCALE=en-US

# Presence rotation (comma-separated, equal length or cycling)
ACTIVITY_TYPES=Listening,Playing
ACTIVITIES=/help • /play,/setup • Music

# Command modes & sharding
ENABLE_PREFIX=true
ENABLE_SLASH_COMMAND=true
ENABLE_SHARDING=false

# --- Provider & Lyrics Integrations ---
# Legitimate Stegripe API lyrics bearer token (optional; LrcLib serves as automatic unauthenticated fallback)
STEGRIPE_API_URL=https://api.stegripe.org
STEGRIPE_API_LYRICS_TOKEN=

# Spotify Web API Client Credentials (used ONLY for metadata lookup, matched onto authorized playback sources)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# --- Optional YouTube Browser Auth (/login command or headless VPS cookies) ---
DEVTOOLS_PORT=9222
CHROMIUM_PATH=
COOKIES_ENCRYPTION_KEY=
# Optional Netscape cookies.txt content (plain multiline, \n-escaped, or base64) for datacenter/VPS IPs
YOUTUBE_COOKIES=
# Set true on dual-stack VPS hosts if YouTube bot-blocks IPv6
YTDLP_FORCE_IPV4=false

# --- Persistence & Coordination ---
# Leave blank locally only for ephemeral in-memory dev runs; Docker Compose injects Postgres & Redis automatically.
POSTGRES_USER=rawon
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=rawon
DATABASE_URL=postgres://rawon:change_me_strong_password@127.0.0.1:5432/rawon
REDIS_URL=redis://127.0.0.1:6379

# --- Storage, Audio Cache & Quality ---
CACHE_DIR=./cache
DATA_DIR=./data
AUDIO_CACHE_MAX_MB=512
AUDIO_CACHE_MAX_FILES=100
AUDIO_QUALITY_PROFILE=fidelity
AUDIO_NORMALIZE=false

# --- Request Channel & Queue Guardrails ---
MAX_QUEUE_SIZE=500
RC_RATE_LIMIT_MAX=5
RC_RATE_LIMIT_WINDOW_MS=15000

# --- Worker, Observability & Binaries ---
WORKER_CONCURRENCY=2
METRICS_HOST=127.0.0.1
METRICS_PORT=9090
WORKER_HEALTH_PORT=9091
FFMPEG_PATH=
YT_DLP_PATH=
