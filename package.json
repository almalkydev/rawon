{
    "name": "rawon-v2",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "Rawon V2 - Modular high-performance Discord music platform",
    "license": "CC-BY-NC-ND-4.0",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=8.0.0"
    },
    "scripts": {
        "build": "pnpm -r --workspace-concurrency=4 build",
        "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
        "lint": "biome check packages apps tests",
        "lint:fix": "biome check --write packages apps tests",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:audio": "vitest run tests/audio",
        "bench:audio": "tsx tests/performance/audio-benchmark.ts",
        "db:migrate": "pnpm --filter @rawon/database migrate",
        "start": "node apps/bot/dist/index.js",
        "start:worker": "node apps/worker/dist/index.js",
        "dev": "tsx apps/bot/src/index.ts",
        "dev:worker": "tsx apps/worker/src/index.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.7",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "ffmpeg-static"
        ]
    }
}
